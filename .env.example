# Where the Nuxt server reaches Strapi
NUXT_STRAPI_URL=http://localhost:1337
# Where the browser loads Strapi media (/uploads/...) from
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Strapi API token (Settings > API Tokens). Read-only is enough.
# Required for draft previews; optional otherwise if the Public role can find/findOne.
NUXT_STRAPI_TOKEN=
# Must match PREVIEW_SECRET in the Strapi .env
NUXT_PREVIEW_SECRET=
